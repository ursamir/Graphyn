{
  "schema_version": "1.1",
  "metadata": {
    "name": "tpl-cross-call-analytics",
    "seed": 42,
    "description": "Transcribe calls locally, redact PII, extract summary/sentiment fields, gate and store results.",
    "created_at": null,
    "tags": [
      "cross",
      "captions",
      "call-analytics"
    ],
    "pack": "Common",
    "industry": "general",
    "marketplace_id": "tpl-cross-call-analytics",
    "status": "ready",
    "source_example": "marketplace/tpl-cross-call-analytics.graph.json",
    "base_template": "tpl-cross-call-analytics"
  },
  "nodes": [
    {
      "id": "n0",
      "node_type": "dataset_ingest",
      "config": {
        "source_type": "filesystem",
        "recursive": true,
        "limit": 8,
        "path": "workspace/datasets/input/speech-commands"
      },
      "label": "ingest",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n1",
      "node_type": "audio_conditioner",
      "config": {
        "target_sample_rate": 16000,
        "mono": true
      },
      "label": "condition",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n2",
      "node_type": "asr_transcribe",
      "config": {
        "provider": "local_whisper",
        "model": "tiny",
        "language": "en"
      },
      "label": "transcribe",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n3",
      "node_type": "pii_redact",
      "config": {
        "engine": "auto"
      },
      "label": "redact",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n4",
      "node_type": "structured_llm",
      "config": {
        "provider": "rule_based",
        "schema_name": "call_analytics",
        "json_schema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "sentiment": {
              "type": "string"
            }
          }
        }
      },
      "label": "extract",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n5",
      "node_type": "eval_gate",
      "config": {
        "check_empty_transcript": false,
        "required_keys": [],
        "fail_if_empty_list": false
      },
      "label": "gate",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "n6",
      "node_type": "object_store",
      "config": {
        "operation": "put",
        "prefix": "calls"
      },
      "label": "store",
      "capability_metadata": null,
      "event_trigger": null
    }
  ],
  "edges": [
    {
      "src_id": "n0",
      "src_port": "output",
