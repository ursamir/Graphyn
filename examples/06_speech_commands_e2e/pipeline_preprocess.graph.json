    },
    {
      "src_id": "audio_quality_gate_4",
      "src_port": "output",
      "dst_id": "augmentation_pipeline_5",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "augmentation_pipeline_5",
