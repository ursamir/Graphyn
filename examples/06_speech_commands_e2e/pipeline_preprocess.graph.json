{
  "schema_version": "1.2",
  "metadata": {
    "name": "speech_commands_e2e_preprocess",
    "seed": 42,
    "description": "E2E speech commands \u2014 preprocessing phase (one command at a time, appending to shared output).",
    "created_at": null,
    "tags": [
      "audio",
      "speech-commands",
      "e2e",
      "preprocessing"
    ]
  },
  "nodes": [
    {
      "id": "dataset_ingest_0",
      "node_type": "dataset_ingest",
      "config": {
        "path": "workspace/datasets/input/speech-commands/yes",
        "source_type": "filesystem",
        "recursive": false
      },
      "label": "Load recordings \u00b7 yes",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "audio_conditioner_1",
      "node_type": "audio_conditioner",
      "config": {
        "target_sample_rate": 16000,
        "mono": true,
        "normalize": true,
        "normalize_method": "peak"
      },
      "label": "Clean audio \u00b7 16 kHz mono",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "segmenter_2",
      "node_type": "segmenter",
      "config": {
        "mode": "silence",
        "silence_threshold_db": 40.0
      },
      "label": "Split on silence",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "audio_quality_gate_3",
      "node_type": "audio_quality_gate",
      "config": {
        "min_snr_db": 5.0,
        "rejection_policy": "skip",
        "check_duration": false
      },
      "label": "Quality check \u00b7 SNR \u2265 5 dB",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "audio_quality_gate_4",
      "node_type": "audio_quality_gate",
      "config": {
        "min_duration_s": 0.2,
        "max_duration_s": 1.0,
        "rejection_policy": "skip",
        "check_duration": true,
        "check_snr": false,
        "check_clipping": false,
        "check_silence": false,
        "check_bandwidth": false
      },
      "label": "Length check \u00b7 0.2\u20131.0 s",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "augmentation_pipeline_5",
      "node_type": "augmentation_pipeline",
      "config": {
        "copies_per_sample": 2,
        "augmentations": [
          {
            "type": "pitch_shift",
            "apply_prob": 1.0,
            "semitones": [
              -2.0,
              2.0
            ]
          },
          {
            "type": "time_stretch",
            "apply_prob": 1.0,
            "rate": [
              0.9,
              1.1
            ]
          }
        ]
      },
      "label": "Augment \u00b7 pitch + tempo \u00d72",
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "audio_exporter_6",
      "node_type": "audio_exporter",
      "config": {
        "output_dir": "workspace/datasets/output/audio_export",
        "split_ratios": {
          "train": 0.7,
          "val": 0.15,
          "test": 0.15
        },
        "version_tag": "v1",
        "random_seed": 42,
        "append": false
      },
      "label": "Save dataset \u00b7 new version",
      "capability_metadata": null,
      "event_trigger": null
    }
  ],
  "edges": [
    {
      "src_id": "dataset_ingest_0",
      "src_port": "output",
      "dst_id": "audio_conditioner_1",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "audio_conditioner_1",
      "src_port": "output",
      "dst_id": "segmenter_2",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "segmenter_2",
