{
  "schema_version": "1.2",
  "metadata": {
    "name": "distributed_placement_demo",
    "seed": 42,
    "description": "Two-box demo with Common nodes: local python_code → remote set_map pinned with placement.tags=[\"gpu\"], require_gpu=true → local json_transform sink. Use GRAPHYN_BACKEND=distributed and graphyn worker start --labels gpu (Server-99). Trainer-style graphs belong in the runbook, not this checked-in example.",
    "created_at": null,
    "tags": ["example", "distributed", "placement", "gpu"]
  },
  "nodes": [
    {
      "id": "prepare",
      "node_type": "python_code",
      "config": {
        "source": "output = {\"batch\": 1, \"features\": [0.1, 0.2, 0.3], \"device_hint\": \"cpu\"}\n"
      },
      "label": "Local prepare",
      "capability_metadata": null,
      "event_trigger": null,
      "placement": {
        "mode": "local"
      }
    },
    {
      "id": "gpu_step",
      "node_type": "set_map",
      "config": {
        "set": {
          "device_hint": "gpu",
          "worker_step": true
        },
        "copy_fields": {
          "batch": "batch",
          "features": "features"
        }
      },
      "label": "GPU-tagged remote step (Server-99)",
      "capability_metadata": {
        "requires_gpu": true,
        "supports_cpu": false,
        "supports_edge": false,
        "deterministic": true,
        "cacheable": true,
        "streaming_support": false,
        "realtime_support": false
      },
      "event_trigger": null,
      "placement": {
        "mode": "auto",
        "tags": ["gpu"],
        "require_gpu": true
      }
    },
    {
      "id": "sink",
      "node_type": "json_transform",
      "config": {
        "pick": ["batch", "device_hint", "worker_step", "features"]
      },
      "label": "Local sink",
      "capability_metadata": null,
      "event_trigger": null,
      "placement": {
        "mode": "local"
      }
    }
  ],
  "edges": [
    {
      "src_id": "prepare",
      "src_port": "output",
      "dst_id": "gpu_step",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "gpu_step",
      "src_port": "output",
      "dst_id": "sink",
      "dst_port": "input",
      "condition": null
    }
  ]
}
