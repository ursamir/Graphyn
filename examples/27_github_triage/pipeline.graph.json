{
  "schema_version": "1.1",
  "metadata": {
    "name": "github_triage",
    "seed": 42,
    "description": "GitHub triage: mock HTTP issues \u2192 ASR/PII/LLM extract \u2192 IF \u2192 mock comment HTTP.",
