{
  "schema_version": "1.2",
  "metadata": {
    "name": "github_triage",
    "seed": 42,
    "description": "Issue triage, offline: transcribe voice notes with local Whisper, redact PII, rule-based severity/summary/labels extract, if_switch on severity, write the triage queue CSV. No tokens. pipeline.live.graph.json reads and comments on GitHub issues (GITHUB_TOKEN) with an OpenAI-compatible LLM.",
    "created_at": null,
    "tags": [
      "example",
      "github",
      "triage",
      "workflow"
    ]
  },
  "nodes": [
    {
      "id": "asr",
      "node_type": "asr_transcribe",
      "config": {
        "provider": "local_whisper",
        "language": "en",
        "model": "tiny"
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "ingest",
      "node_type": "dataset_ingest",
      "config": {
        "path": "workspace/datasets/input/wake-word/wake_word",
        "source_type": "filesystem",
        "recursive": false,
        "limit": 1
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "pii",
      "node_type": "pii_redact",
      "config": {
        "engine": "auto"
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "llm",
      "node_type": "structured_llm",
      "config": {
        "provider": "rule_based",
        "schema_name": "triage",
        "json_schema": {
          "type": "object",
          "properties": {
            "severity": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "severity",
            "summary"
          ]
        }
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "branch",
      "node_type": "if_switch",
      "config": {
        "jsonpath": "$.data.severity"
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "queue",
      "node_type": "csv_table",
      "config": {
        "operation": "write",
        "path": "artifacts/github-triage/queue.csv"
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    },
    {
      "id": "backlog",
      "node_type": "csv_table",
      "config": {
        "operation": "write",
        "path": "artifacts/github-triage/backlog.csv"
      },
      "label": null,
      "capability_metadata": null,
      "event_trigger": null
    }
  ],
  "edges": [
    {
      "src_id": "ingest",
      "src_port": "output",
      "dst_id": "asr",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "asr",
      "src_port": "output",
      "dst_id": "pii",
      "dst_port": "transcript",
      "condition": null
    },
    {
      "src_id": "pii",
      "src_port": "transcript",
      "dst_id": "llm",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "llm",
      "src_port": "output",
      "dst_id": "branch",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "branch",
      "src_port": "true",
      "dst_id": "queue",
      "dst_port": "input",
      "condition": null
    },
    {
      "src_id": "branch",
      "src_port": "false",
      "dst_id": "backlog",
      "dst_port": "input",
      "condition": null
    }
  ],
  "parameters": {}
}
