GRAPHYN_API_TOKEN=change-me
# Audit principal recorded for requests made with the shared token (default: operator).
# Use named tokens (GRAPHYN_API_TOKENS) or user accounts for per-person attribution.
GRAPHYN_API_TOKEN_ACTOR=operator

# Leave unset for API/UI. Set to 1 only in isolated unit tests.
# GRAPHYN_SKIP_PLUGIN_LOAD=1
# GRAPHYN_HOME=~/.graphyn
# GRAPHYN_PROJECT_DIR=workspace

# --- Broader surface: LLM + outbound mail (optional; fail-closed without these) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_BASE_URL=http://172.17.0.1:11434/v1
# OLLAMA_MODEL=tinyllama:1.1b
# OLLAMA_NUM_GPU=0
# Network egress (SSRF): restricted is the default. Private targets (e.g. the
# host Ollama above) must be listed explicitly; metadata IPs are always denied.
# GRAPHYN_HTTP_EGRESS_MODE=restricted
# GRAPHYN_HTTP_EGRESS_INTERNAL_ALLOW=172.17.0.1:11434,host.docker.internal:11434
# GRAPHYN_HTTP_EGRESS_ALLOWLIST=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash
# GRAPHYN_SMTP_HOST=
# GRAPHYN_SMTP_PORT=587
# GRAPHYN_SMTP_USER=
# GRAPHYN_SMTP_PASSWORD=
# GRAPHYN_SMTP_PASSWORD_SECRET=
# GRAPHYN_SMTP_FROM=
# GRAPHYN_SMTP_TLS=1
# GRAPHYN_SMTP_DRY_RUN=1
# GRAPHYN_NOTIFY_EMAIL_TO=

# --- Credential store (platform connections by kind) ---
# Optional master key (urlsafe base64 32-byte or any passphrase).
# If unset, a key is generated once into {GRAPHYN_HOME}/credentials/.key (0600).
# GRAPHYN_CREDENTIALS_KEY=
# Optional: bind run-notify SMTP to a connection id (else workspace default / env).
# GRAPHYN_SMTP_CONNECTION_ID=

# Mode B job-status poll interval (seconds). Target ~1 GET /jobs/{id} per 3-5s.
GRAPHYN_WORKER_JOB_POLL_S=4.0
GRAPHYN_JOB_WAIT_POLL_S=4.0


# --- OIDC / SSO (optional; off by default) ---
# GRAPHYN_OIDC_ENABLED=1
# GRAPHYN_OIDC_ISSUER=https://login.example.com/realms/graphyn
# GRAPHYN_OIDC_CLIENT_ID=graphyn-console
# GRAPHYN_OIDC_CLIENT_SECRET=
# GRAPHYN_OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
# GRAPHYN_OIDC_UI_ORIGIN=http://localhost:5173
# GRAPHYN_OIDC_SCOPES=openid profile email
# GRAPHYN_OIDC_AUTO_PROVISION=1
# GRAPHYN_OIDC_DEFAULT_ROLES=viewer
# GRAPHYN_OIDC_PASSWORD_LOGIN=1
# GRAPHYN_OIDC_USERNAME_CLAIM=preferred_username
# GRAPHYN_OIDC_DISPLAY_NAME_CLAIM=name
# GRAPHYN_OIDC_EMAIL_CLAIM=email

# --- Billing webhook seam (Wave 3; optional) ---
# GRAPHYN_BILLING_WEBHOOK_SECRET=

# --- KMS / BYOK (Wave 4; optional) ---
# GRAPHYN_KMS_BACKEND=local
# GRAPHYN_KMS_BACKEND=envelope
# GRAPHYN_KMS_CMK=customer-master-passphrase
# GRAPHYN_KMS_CMK_PATH=/path/to/cmk.raw
# Cloud KMS (aws/gcp/azure) is NOT shipped — implement KeyProvider to plug in.

# --- Data residency (Wave 4; optional) ---
# GRAPHYN_RESIDENCY_REGION=us-east-1
# GRAPHYN_RESIDENCY_ENFORCE=0
# GRAPHYN_RESIDENCY_STRICT_UNSET=0

# --- Audit retention / compliance export (Wave 4) ---
# GRAPHYN_AUDIT_RETENTION_DAYS=365
# GRAPHYN_AUDIT_RETENTION_ENFORCE=0
# GET /api/v1/compliance/export  GET /api/v1/compliance/status

# --- Plugin isolation sandbox (Wave 5; optional; default subprocess) ---
# GRAPHYN_PLUGIN_ISOLATION=subprocess
# GRAPHYN_PLUGIN_ISOLATION=container
# GRAPHYN_PLUGIN_SANDBOX_RUNTIME=docker
# GRAPHYN_PLUGIN_SANDBOX_IMAGE=python:3.12-slim
# GRAPHYN_PLUGIN_SANDBOX_NETWORK=allowlist
# TEE/SGX: Not shipped (no attested hardware path).

# --- Agent principals (Wave 6; admin-minted gxa_ tokens) ---
# Create via Access → Agents or POST /api/v1/agents. Pass token as Bearer or MCP _meta.auth_token.
# OIDC client_credentials for agents is Not shipped (oidc_client_id is a label only).
